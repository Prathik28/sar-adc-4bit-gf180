* complete 4-bit SAR ADC
.include models.sp
.include cells.sp
.param cu=25f
VDD vdd 0 2
VREF vref 0 2
VCM vcm 0 1
VCK clk 0 pulse(0 2 10n 100p 100p 9.9n 20n)
VRST rst 0 pwl(0 2 25n 2 25.1n 0)
VIN vin 0 pwl(0 0 2n 0 2.5n 0.007812 122n 0.007812 122.5n 0.023438 242n 0.023438 242.5n 0.039062 362n 0.039062 362.5n 0.054688 482n 0.054688 482.5n 0.070312 602n 0.070312 602.5n 0.085938 722n 0.085938 722.5n 0.101562 842n 0.101562 842.5n 0.117188 962n 0.117188 962.5n 0.132812 1082n 0.132812 1082.5n 0.148438 1202n 0.148438 1202.5n 0.164062 1322n 0.164062 1322.5n 0.179688 1442n 0.179688 1442.5n 0.195312 1562n 0.195312 1562.5n 0.210938 1682n 0.210938 1682.5n 0.226562 1802n 0.226562 1802.5n 0.242188 1922n 0.242188 1922.5n 0.257812 2042n 0.257812 2042.5n 0.273438 2162n 0.273438 2162.5n 0.289062 2282n 0.289062 2282.5n 0.304688 2402n 0.304688 2402.5n 0.320312 2522n 0.320312 2522.5n 0.335938 2642n 0.335938 2642.5n 0.351562 2762n 0.351562 2762.5n 0.367188 2882n 0.367188 2882.5n 0.382812 3002n 0.382812 3002.5n 0.398438 3122n 0.398438 3122.5n 0.414062 3242n 0.414062 3242.5n 0.429688 3362n 0.429688 3362.5n 0.445312 3482n 0.445312 3482.5n 0.460938 3602n 0.460938 3602.5n 0.476562 3722n 0.476562 3722.5n 0.492188 3842n 0.492188 3842.5n 0.507812 3962n 0.507812 3962.5n 0.523438 4082n 0.523438 4082.5n 0.539062 4202n 0.539062 4202.5n 0.554688 4322n 0.554688 4322.5n 0.570312 4442n 0.570312 4442.5n 0.585938 4562n 0.585938 4562.5n 0.601562 4682n 0.601562 4682.5n 0.617188 4802n 0.617188 4802.5n 0.632812 4922n 0.632812 4922.5n 0.648438 5042n 0.648438 5042.5n 0.664062 5162n 0.664062 5162.5n 0.679688 5282n 0.679688 5282.5n 0.695312 5402n 0.695312 5402.5n 0.710938 5522n 0.710938 5522.5n 0.726562 5642n 0.726562 5642.5n 0.742188 5762n 0.742188 5762.5n 0.757812 5882n 0.757812 5882.5n 0.773438 6002n 0.773438 6002.5n 0.789062 6122n 0.789062 6122.5n 0.804688 6242n 0.804688 6242.5n 0.820312 6362n 0.820312 6362.5n 0.835938 6482n 0.835938 6482.5n 0.851562 6602n 0.851562 6602.5n 0.867188 6722n 0.867188 6722.5n 0.882812 6842n 0.882812 6842.5n 0.898438 6962n 0.898438 6962.5n 0.914062 7082n 0.914062 7082.5n 0.929688 7202n 0.929688 7202.5n 0.945312 7322n 0.945312 7322.5n 0.960938 7442n 0.960938 7442.5n 0.976562 7562n 0.976562 7562.5n 0.992188 7682n 0.992188 7682.5n 1.007812 7802n 1.007812 7802.5n 1.023438 7922n 1.023438 7922.5n 1.039062 8042n 1.039062 8042.5n 1.054688 8162n 1.054688 8162.5n 1.070312 8282n 1.070312 8282.5n 1.085938 8402n 1.085938 8402.5n 1.101562 8522n 1.101562 8522.5n 1.117188 8642n 1.117188 8642.5n 1.132812 8762n 1.132812 8762.5n 1.148438 8882n 1.148438 8882.5n 1.164062 9002n 1.164062 9002.5n 1.179688 9122n 1.179688 9122.5n 1.195312 9242n 1.195312 9242.5n 1.210938 9362n 1.210938 9362.5n 1.226562 9482n 1.226562 9482.5n 1.242188 9602n 1.242188 9602.5n 1.257812 9722n 1.257812 9722.5n 1.273438 9842n 1.273438 9842.5n 1.289062 9962n 1.289062 9962.5n 1.304688 10082n 1.304688 10082.5n 1.320312 10202n 1.320312 10202.5n 1.335938 10322n 1.335938 10322.5n 1.351562 10442n 1.351562 10442.5n 1.367188 10562n 1.367188 10562.5n 1.382812 10682n 1.382812 10682.5n 1.398438 10802n 1.398438 10802.5n 1.414062 10922n 1.414062 10922.5n 1.429688 11042n 1.429688 11042.5n 1.445312 11162n 1.445312 11162.5n 1.460938 11282n 1.460938 11282.5n 1.476562 11402n 1.476562 11402.5n 1.492188 11522n 1.492188 11522.5n 1.507812 11642n 1.507812 11642.5n 1.523438 11762n 1.523438 11762.5n 1.539062 11882n 1.539062 11882.5n 1.554688 12002n 1.554688 12002.5n 1.570312 12122n 1.570312 12122.5n 1.585938 12242n 1.585938 12242.5n 1.601562 12362n 1.601562 12362.5n 1.617188 12482n 1.617188 12482.5n 1.632812 12602n 1.632812 12602.5n 1.648438 12722n 1.648438 12722.5n 1.664062 12842n 1.664062 12842.5n 1.679688 12962n 1.679688 12962.5n 1.695312 13082n 1.695312 13082.5n 1.710938 13202n 1.710938 13202.5n 1.726562 13322n 1.726562 13322.5n 1.742188 13442n 1.742188 13442.5n 1.757812 13562n 1.757812 13562.5n 1.773438 13682n 1.773438 13682.5n 1.789062 13802n 1.789062 13802.5n 1.804688 13922n 1.804688 13922.5n 1.820312 14042n 1.820312 14042.5n 1.835938 14162n 1.835938 14162.5n 1.851562 14282n 1.851562 14282.5n 1.867188 14402n 1.867188 14402.5n 1.882812 14522n 1.882812 14522.5n 1.898438 14642n 1.898438 14642.5n 1.914062 14762n 1.914062 14762.5n 1.929688 14882n 1.929688 14882.5n 1.945312 15002n 1.945312 15002.5n 1.960938 15122n 1.960938 15122.5n 1.976562 15242n 1.976562 15242.5n 1.992188)

* ---------------- control FSM (corrected) ----------------
XN q0 q1 q2 rst d0 d1 d2 vdd 0 NSL_FIXED
XR d0 d1 d2 clk q0 q0b q1 q1b q2 q2b vdd 0 FSMREG
XO q0 q1 q2 setb3 setb2 setb1 setb0 eoc vdd 0 OUTL
* sample state S0 = Q2'Q1'Q0' and its phases
XS0a q2b q1b s0a vdd 0 AND2
XS0b s0a q0b s0 vdd 0 AND2
XS0n s0 s0n vdd 0 INV
XPT s0 clk pht vdd 0 AND2
XPTn pht phtb vdd 0 INV
XCKB clk clkc vdd 0 INV

* ---------------- SAR register: D = S0' (SET ? COMP : R) ----------------
XSN0 setb0 setn0 vdd 0 INV
XMA0 setb0 comp ma0 vdd 0 AND2
XMB0 setn0 r0 mb0 vdd 0 AND2
XMO0 ma0 mb0 mo0 vdd 0 OR2
XMC0 mo0 s0n dr0 vdd 0 AND2
XRF0 dr0 clk r0 r0b vdd 0 DFF
* DAC code bit = R or SET
XDO0 r0 setb0 dac0 vdd 0 OR2
XUP0 s0n dac0 upb0 vdd 0 NAND2
XDN0 s0 dac0 dn0 vdd 0 NOR2
XSN1 setb1 setn1 vdd 0 INV
XMA1 setb1 comp ma1 vdd 0 AND2
XMB1 setn1 r1 mb1 vdd 0 AND2
XMO1 ma1 mb1 mo1 vdd 0 OR2
XMC1 mo1 s0n dr1 vdd 0 AND2
XRF1 dr1 clk r1 r1b vdd 0 DFF
* DAC code bit = R or SET
XDO1 r1 setb1 dac1 vdd 0 OR2
XUP1 s0n dac1 upb1 vdd 0 NAND2
XDN1 s0 dac1 dn1 vdd 0 NOR2
XSN2 setb2 setn2 vdd 0 INV
XMA2 setb2 comp ma2 vdd 0 AND2
XMB2 setn2 r2 mb2 vdd 0 AND2
XMO2 ma2 mb2 mo2 vdd 0 OR2
XMC2 mo2 s0n dr2 vdd 0 AND2
XRF2 dr2 clk r2 r2b vdd 0 DFF
* DAC code bit = R or SET
XDO2 r2 setb2 dac2 vdd 0 OR2
XUP2 s0n dac2 upb2 vdd 0 NAND2
XDN2 s0 dac2 dn2 vdd 0 NOR2
XSN3 setb3 setn3 vdd 0 INV
XMA3 setb3 comp ma3 vdd 0 AND2
XMB3 setn3 r3 mb3 vdd 0 AND2
XMO3 ma3 mb3 mo3 vdd 0 OR2
XMC3 mo3 s0n dr3 vdd 0 AND2
XRF3 dr3 clk r3 r3b vdd 0 DFF
* DAC code bit = R or SET
XDO3 r3 setb3 dac3 vdd 0 OR2
XUP3 s0n dac3 upb3 vdd 0 NAND2
XDN3 s0 dac3 dn3 vdd 0 NOR2

* ---------------- capacitive DAC + bottom-plate sampling ----------------
* top plate sampled to VCM while PH_T = S0 & CLK; bottom plates track VIN for all of S0
XTT top vcm pht phtb vdd 0 TGW
C0 top b0 {1*cu}
XSI0 vin b0 s0 s0n vdd 0 TGW
XSR0 b0 upb0 vref vdd pmos_3p3 W=4u L=0.28u
XSG0 b0 dn0 0 0 nmos_3p3 W=4u L=0.28u
C1 top b1 {2*cu}
XSI1 vin b1 s0 s0n vdd 0 TGW
XSR1 b1 upb1 vref vdd pmos_3p3 W=4u L=0.28u
XSG1 b1 dn1 0 0 nmos_3p3 W=4u L=0.28u
C2 top b2 {4*cu}
XSI2 vin b2 s0 s0n vdd 0 TGW
XSR2 b2 upb2 vref vdd pmos_3p3 W=4u L=0.28u
XSG2 b2 dn2 0 0 nmos_3p3 W=4u L=0.28u
C3 top b3 {8*cu}
XSI3 vin b3 s0 s0n vdd 0 TGW
XSR3 b3 upb3 vref vdd pmos_3p3 W=4u L=0.28u
XSG3 b3 dn3 0 0 nmos_3p3 W=4u L=0.28u
CT top bt {cu}
XSIT vin bt s0 s0n vdd 0 TGW
XSGT bt s0n 0 0 nmos_3p3 W=4u L=0.28u
* parasitic on the top plate (wiring + comparator input)
CPT top 0 20f

* ---------------- StrongARM latch comparator + SR latch ----------------
* evaluates while CLK is low (clkc high); COMP = 1 when VCM > top, i.e. VIN >= VDAC
XM0 tail clkc 0 0 nmos_3p3 W=8u L=0.28u
XM1 p vcm tail 0 nmos_3p3 W=8u L=0.28u
XM2 q top tail 0 nmos_3p3 W=8u L=0.28u
XM3 outn outp p 0 nmos_3p3 W=4u L=0.28u
XM4 outp outn q 0 nmos_3p3 W=4u L=0.28u
XM5 outn outp vdd vdd pmos_3p3 W=4u L=0.28u
XM6 outp outn vdd vdd pmos_3p3 W=4u L=0.28u
XS1 outn clkc vdd vdd pmos_3p3 W=2u L=0.28u
XS2 outp clkc vdd vdd pmos_3p3 W=2u L=0.28u
XS3 p clkc vdd vdd pmos_3p3 W=2u L=0.28u
XS4 q clkc vdd vdd pmos_3p3 W=2u L=0.28u
XB1 outn outnb vdd 0 INV
XB2 outp outpb vdd 0 INV
XL1 outnb comp compb vdd 0 NOR2
XL2 outpb compb comp vdd 0 NOR2

.subckt TGW x y en enb vdd vss
XMN x en y vss nmos_3p3 W=8u L=0.28u
XMP x enb y vdd pmos_3p3 W=8u L=0.28u
.ends
.options method=gear
.control
tran 20p 15380.0n
wrdata adc_rampb.txt v(clk) v(vin) v(top) v(comp) v(q0) v(q1) v(q2) v(setb3) v(setb2) v(setb1) v(setb0) v(eoc) v(r3) v(r2) v(r1) v(r0) v(dac3) v(dac2) v(dac1) v(dac0) v(outp) v(outn) v(s0) v(pht)
.endc
.end

